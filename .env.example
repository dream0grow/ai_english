# 복사해서 .env 로 저장한 뒤 값을 채우세요:  cp .env.example .env

# ── Claude 구독 인증 (API 아님!) ─────────────────────────────
# Max/Pro 구독 계정으로 `claude setup-token` 실행 → 발급된 구독 토큰(sk-ant-oat01-...)을 붙여넣기
# ※ API 키(sk-ant-api...)가 아닙니다. 이 앱은 구독 한도 내에서만 동작하며 API 과금이 없습니다.
#    (환경에 ANTHROPIC_API_KEY가 있어도 서버가 자동 제거하여 과금을 차단합니다)
CLAUDE_CODE_OAUTH_TOKEN=

# 대화 모델 (구독 플랜에 따라 sonnet/opus 선택 가능. 비우면 기본값)
CLAUDE_MODEL=sonnet

# ── 서버 ────────────────────────────────────────────────────
PORT=8100

# ── 음성 (STT) ──────────────────────────────────────────────
# tiny(가장 빠름) | base(권장) | small(정확, 느림)
WHISPER_MODEL=base

# ── 음성 (TTS) ──────────────────────────────────────────────
# kokoro(권장) | none(음성 끄고 브라우저 내장 음성 사용)
TTS_ENGINE=kokoro
# Kokoro 음성: af_heart(여성, 기본) af_bella am_michael(남성) 등
TTS_VOICE=af_heart

# ── 개발/테스트 ─────────────────────────────────────────────
# 1로 설정하면 Claude 대신 고정 응답(토큰 없이 파이프라인 테스트용)
MOCK_LLM=0
